      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(opn_rpc_server_duration_milliseconds_count{service_name=~\"api-cpp|api-python|api-java|api-go|api-csharp|api-node\"}[5m])) by (service_name)",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "Request rate — all six languages",
      "type": "timeseries"
    },
