        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(k6_grpc_req_duration_bucket[1m])) by (le, lang))",
          "legendFormat": "{{lang}} p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.98, sum(rate(k6_grpc_req_duration_bucket[1m])) by (le, lang))",
          "legendFormat": "{{lang}} p98",
          "refId": "C"
        }
      ],
      "title": "k6 gRPC duration — p90 / p95 / p98 by LANG",
