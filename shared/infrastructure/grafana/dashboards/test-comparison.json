{
  "__comment": "k6 experimental-prometheus-rw exports trend stats as gauges (k6_grpc_req_duration_p90), not _bucket histograms. Values are seconds.",
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 }, "overrides": [] },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "avg by (lang) (k6_grpc_req_duration_p90)",
          "legendFormat": "{{lang}} p90",
          "refId": "A"
        },
        {
          "expr": "avg by (lang) (k6_grpc_req_duration_p95)",
          "legendFormat": "{{lang}} p95",
          "refId": "B"
        },
        {
          "expr": "avg by (lang) (k6_grpc_req_duration_p98)",
          "legendFormat": "{{lang}} p98",
          "refId": "C"
        },
        {
          "expr": "avg by (lang) (k6_grpc_req_duration_p99)",
          "legendFormat": "{{lang}} p99",
          "refId": "D"
        }
      ],
      "title": "k6 gRPC duration — p90 / p95 / p98 / p99 by LANG",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 2,
      "targets": [
        {
          "expr": "avg by (lang) (k6_grpc_req_duration_p95)",
          "legendFormat": "{{lang}}",
          "refId": "A"
        }
      ],
      "title": "p95 comparison by language",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (lang) (rate(k6_iterations_total[1m]))",
          "legendFormat": "{{lang}}",
          "refId": "A"
        }
      ],
      "title": "k6 iteration rate by language",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 17 },
      "id": 4,
      "targets": [
        {
          "expr": "1 - avg by (lang) (k6_checks_rate)",
          "legendFormat": "{{lang}} fail ratio (1 - checks_rate)",
          "refId": "A"
        }
      ],
      "title": "k6 check fail ratio by language",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
